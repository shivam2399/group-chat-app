# ==========================================
# Docker Compose Environment Configuration
# Copy this file to .env before running docker compose up:
#   cp docker-compose.env.example .env
# ==========================================

# Database Credentials
MYSQL_ROOT_PASSWORD=supersecretrootpass
DB_NAME=group_chat_db
DB_USER=chatuser
DB_PASSWORD=chatuserpassword
DB_PORT=3306

# Application Configuration
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=*
JWT_SECRET=generate_a_random_64_byte_hex_secret_here

# AWS S3 Configuration (Optional: for direct browser file uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your_s3_bucket_name

# Google Gemini AI (Optional: for auto-complete & smart suggestions)
GEMINI_API_KEY=your_gemini_api_key

